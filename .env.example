# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=reedshelf_super_secret_jwt_key_replace_in_production_2026

# SQLite Database File Path (defaults to server/data/reedshelf.db)
DATABASE_PATH=./server/data/reedshelf.db

# --------------------------------------------------------------------------
# Supabase PostgreSQL & Supabase Auth Configuration
# --------------------------------------------------------------------------
# 1. Supabase Project URL:
#    In your Supabase Dashboard -> Project Settings -> API -> Project URL
#    e.g. https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase API Key:
#    In Supabase Dashboard -> Project Settings -> API -> Project API Keys
#    Use service_role secret key for backend and anon key for frontend
SUPABASE_KEY=your_supabase_service_role_or_anon_key
VITE_SUPABASE_KEY=your_supabase_anon_key

# --------------------------------------------------------------------------
# Cloudflare R2 Object Storage (Unlimited PDF uploads with 0 egress fees)
# --------------------------------------------------------------------------
# Find these in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=reedshelf-books
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-id.r2.dev

# --------------------------------------------------------------------------
# Email Service (SMTP) Configuration for Authenticator Verification Codes
# --------------------------------------------------------------------------
# Option A: Brevo (Sendinblue) Transactional SMTP (Recommended)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_brevo_login_email@smtp-brevo.com
# SMTP_PASS=your_brevo_xsmtpsib_key
# EMAIL_FROM="ReedShelf" <your_verified_email@gmail.com>
#
# Option B: Gmail App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password

