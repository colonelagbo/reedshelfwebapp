# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=reedshelf_super_secret_jwt_key_replace_in_production_2026

# SQLite Database File Path (defaults to server/data/reedshelf.db)
DATABASE_PATH=./data/reedshelf.db

# --------------------------------------------------------------------------
# Supabase Storage Configuration
# --------------------------------------------------------------------------
# 1. Supabase Project URL:
#    In your Supabase Dashboard -> Project Settings -> API -> Project URL
#    e.g. https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase API Key:
#    In Supabase Dashboard -> Project Settings -> API -> Project API Keys
#    Use either the `service_role` secret key (recommended for backend) or `anon` public key
SUPABASE_KEY=your_supabase_api_key_here

# 3. Supabase Storage Bucket Name:
#    Name of the bucket for storing PDF books (default: reedshelf-books)
#    (The backend will automatically create this bucket if it doesn't exist!)
SUPABASE_BUCKET_NAME=reedshelf-books
